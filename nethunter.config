# NetHunter para A04e (kernel 4.19.191) - sin KernelSU, el root sigue siendo Magisk
# Misma version que el kernel de fabrica: los modulos wifi/bt/gps del vendor la exigen
CONFIG_LOCALVERSION="-28581296-abA042MUBSDEYG1"
# CONFIG_LOCALVERSION_AUTO is not set

# Chroot de Kali. SYSVIPC/POSIX_MQUEUE NO: cambian task_struct y rompen los .ko del vendor
CONFIG_BINFMT_MISC=y

# Modulos
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODULE_FORCE_UNLOAD=y
CONFIG_MODULE_SIG=n

# Wifi: inyeccion / monitor mode en adaptadores USB
# CFG80211_WEXT NO: cambia net_device y rompe wlan_drv_gen4m
# MAC80211_MESH NO: cambia sk_buff (CRC de __alloc_skb) y rompe los .ko del vendor
CONFIG_MAC80211_DEBUGFS=n
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_ATH9K_HTC=y
CONFIG_CARL9170=y
CONFIG_WLAN_VENDOR_RALINK=y
CONFIG_RT2X00=y
CONFIG_RT2800USB=y
CONFIG_RT2800USB_RT33XX=y
CONFIG_RT2800USB_RT35XX=y
CONFIG_RT2800USB_RT3573=y
CONFIG_RT2800USB_RT53XX=y
CONFIG_RT2800USB_RT55XX=y
CONFIG_RT2800USB_UNKNOWN=y
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_RTL8187=y
CONFIG_RTL8XXXU=y
CONFIG_RTL8XXXU_UNTESTED=y
CONFIG_WLAN_VENDOR_MEDIATEK=y
CONFIG_MT7601U=y
CONFIG_MT76_CORE=y
CONFIG_MT76x0U=y
CONFIG_MT76x2U=y
CONFIG_USB_NET_RNDIS_WLAN=y

# USB gadget: HID (teclado/raton), RNDIS/ECM, mass storage, serie
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_F_HID=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_ECM_SUBSET=y
CONFIG_USB_CONFIGFS_EEM=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_SERIAL=y

# USB host: adaptadores serie y bluetooth
CONFIG_USB_SERIAL=y
CONFIG_USB_SERIAL_GENERIC=y
CONFIG_USB_SERIAL_CH341=y
CONFIG_USB_SERIAL_CP210X=y
CONFIG_USB_SERIAL_FTDI_SIO=y
CONFIG_USB_SERIAL_PL2303=y
CONFIG_BT_HCIBTUSB=y
